{
  "format": 1,
  "name": "msg-duplicate",
  "description": "A message repeated with the same identity and content is acknowledged and recorded as a duplicate but not delivered again; the same identity with different content is processed as a revision.",
  "requirements": ["MSG-06", "MSG-03", "PRO-03", "LOG-01"],
  "timeout_ms": 30000,
  "resources": { "ports": ["in"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "hl7-in", "label": "HL7 in", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.in}" } },
        { "endpoint_id": "lis-out", "label": "LIS HL7 interface", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.lis.port}" } }
      ],
      "channels": [
        { "channel_id": "hl7-dup", "label": "HL7 duplicate detection", "kind": "message",
          "source": { "endpoint": "hl7-in", "protocol": "hl7_mllp", "settings": { "ack_mode": "original" }, "duplicate_detection": true },
          "destinations": [
            { "destination_id": "lis", "label": "LIS", "endpoint": "lis-out", "protocol": "hl7_mllp",
              "settings": { "ack_mode": "original" }, "mapping": null, "delivery": { "ack_timeout_seconds": 5 } }
          ] }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "lis": { "kind": "tcp_server" }
  },
  "no_body_leak": ["PID-TEST-004", "TEST^PATIENT"],
  "steps": [
    { "do": "accept", "actor": "lis" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.in}" },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-DUP-1|P|2.5.1",
        "PID|1||PID-TEST-004||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0004|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||95|mg/dL|70-110|N|||F|||20260101115900"
      ] },
    { "do": "expect_message", "actor": "lis", "protocol": "hl7_mllp", "reply": "AA",
      "assert": [ { "path": "MSH.10", "equals": "CTRL-DUP-1" }, { "path": "OBX.5", "equals": "95" } ] },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA",
      "note": "byte-identical repeat",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-DUP-1|P|2.5.1",
        "PID|1||PID-TEST-004||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0004|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||95|mg/dL|70-110|N|||F|||20260101115900"
      ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-DUP-1", "state": "routed" }, "count": 1 },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-DUP-1", "state": "duplicate" }, "count": 1,
      "each": { "duplicate_of": { "exists": true }, "response_code": "AA" } },
    { "do": "expect_no_data", "actor": "lis", "for_ms": 700 },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "channel_id": "hl7-dup" }, "count": 1, "within_ms": 0,
      "each": { "state": "acknowledged", "ack_level": "accepted" } },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "hl7-dup" },
      "expect": { "counters.received": 2, "counters.duplicates": 1, "destinations[destination_id=lis].counters.acknowledged": 1 } },
    { "do": "assert_log", "actor": "engine", "event": "message.duplicate", "fields": { "channel_id": "hl7-dup" }, "count": 1 },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA",
      "note": "same identity, corrected value",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-DUP-1|P|2.5.1",
        "PID|1||PID-TEST-004||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0004|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||96|mg/dL|70-110|N|||C|||20260101115900"
      ] },
    { "do": "expect_message", "actor": "lis", "protocol": "hl7_mllp", "reply": "AA",
      "assert": [ { "path": "MSH.10", "equals": "CTRL-DUP-1" }, { "path": "OBX.5", "equals": "96" } ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-DUP-1", "revision_of": { "exists": true } }, "count": 1,
      "each": { "state": "routed" } },
    { "do": "assert_log", "actor": "engine", "event": "message.identity_reused", "fields": { "channel_id": "hl7-dup" }, "count": 1 },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "channel_id": "hl7-dup" }, "count": 2, "within_ms": 5000,
      "each": { "state": "acknowledged" } }
  ]
}
