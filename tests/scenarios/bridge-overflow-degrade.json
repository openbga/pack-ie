{
  "format": 1,
  "name": "bridge-overflow-degrade",
  "description": "A slow receiver fills the bounded buffer: the bridge degrades once, raises an alert, applies backpressure without losing a byte, and recovers when the receiver drains.",
  "requirements": ["BRG-03", "LOG-03", "EPT-06"],
  "timeout_ms": 90000,
  "resources": { "ports": ["a"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "inst-side", "label": "Instrument side", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.a}" } },
        { "endpoint_id": "sys-side", "label": "System side", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.sys.port}" } }
      ],
      "channels": [
        { "channel_id": "bridge-1", "label": "Bridge 1", "kind": "bridge",
          "endpoint_a": "inst-side", "endpoint_b": "sys-side",
          "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
          "buffer": { "max_buffered_segments": 8, "max_bytes": 65536, "overflow_action": "block_then_degrade", "block_timeout_ms": 200 },
          "retry": { "initial_delay_ms": 200, "max_delay_ms": 1000, "multiplier": 2.0, "jitter_percent": 0, "max_consecutive_failures_before_alert": 3 } }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "sys": { "kind": "tcp_server", "recv_buffer_bytes": 4096 }
  },
  "steps": [
    { "do": "accept", "actor": "sys" },
    { "do": "pause_reading", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },

    { "do": "send", "actor": "inst", "generate": { "pattern": "counter32", "bytes": 33554432, "seed": 0 }, "async": true, "name": "big" },

    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" }, "within_ms": 20000,
      "expect": {
        "state": "degraded",
        "session_state": "bridged",
        "counters.overflow_count": { "gte": 1 },
        "buffers.a_to_b.overflowing": true,
        "buffers.a_to_b.max_bytes": 65536,
        "buffers.a_to_b.max_segments": 8,
        "buffers.a_to_b.bytes": { "gt": 0 },
        "buffers.b_to_a.overflowing": false
      } },
    { "do": "assert_alert", "actor": "engine", "code": "bridge_buffer_pressure", "scope": { "channel": "bridge-1" },
      "expect": { "severity": "critical", "state": "active" } },
    { "do": "assert_log", "actor": "engine", "event": "buffer.overflow_detected",
      "fields": { "channel_id": "bridge-1", "direction": "a_to_b" }, "count": 1 },
    { "do": "await_send", "actor": "inst", "name": "big", "expect": "pending", "for_ms": 500 },

    { "do": "resume_reading", "actor": "sys" },
    { "do": "expect", "actor": "sys", "generate": { "pattern": "counter32", "bytes": 33554432, "seed": 0 }, "timeout_ms": 60000 },
    { "do": "await_send", "actor": "inst", "name": "big", "timeout_ms": 60000 },

    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" }, "within_ms": 10000,
      "expect": {
        "state": "running",
        "counters.bytes_a_to_b": 33554432,
        "counters.overflow_count": { "gte": 1 },
        "buffers.a_to_b.overflowing": false
      } },
    { "do": "assert_log", "actor": "engine", "event": "buffer.overflow_cleared", "fields": { "channel_id": "bridge-1" } },
    { "do": "assert_alert", "actor": "engine", "code": "bridge_buffer_pressure", "scope": { "channel": "bridge-1" }, "present": false }
  ]
}
