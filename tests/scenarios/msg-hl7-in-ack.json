{
  "format": 1,
  "name": "msg-hl7-in-ack",
  "description": "HL7 over MLLP in: original and enhanced acknowledgements follow the commit, an invalid message is stored and rejected, and a mapped result is written as a delimited file.",
  "requirements": ["MSG-01", "MSG-02", "MSG-07", "PRO-03", "PRO-04", "LOG-02"],
  "timeout_ms": 30000,
  "resources": { "ports": ["orig", "enh"], "folders": ["out"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "hl7-in-orig", "label": "HL7 in (original mode)", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.orig}" } },
        { "endpoint_id": "hl7-in-enh", "label": "HL7 in (enhanced mode)", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.enh}" } },
        { "endpoint_id": "out-dir", "label": "Result files", "kind": "folder",
          "settings": { "path": "${folder.out}" } }
      ],
      "channels": [
        { "channel_id": "hl7-orig", "label": "HL7 original ACK", "kind": "message",
          "source": { "endpoint": "hl7-in-orig", "protocol": "hl7_mllp", "settings": { "ack_mode": "original" } },
          "filters": [ { "path": "MSH.9.1", "op": "equals", "value": "ORU" } ],
          "destinations": [
            { "destination_id": "csv", "label": "CSV file", "endpoint": "out-dir", "protocol": "delimited_file",
              "settings": {
                "header_row": true, "file_name": "orig-{message_id}.csv", "line_ending": "crlf",
                "columns": [
                  { "name": "sample_id", "position": 1 }, { "name": "patient_id", "position": 2 },
                  { "name": "test_code", "position": 3 }, { "name": "value", "type": "decimal", "position": 4 },
                  { "name": "result_time", "type": "datetime", "format": "yyyy-MM-dd HH:mm:ss", "position": 5 }
                ] },
              "mapping": { "rules": [
                { "op": "copy", "from": "OBR.3", "to": "col.sample_id" },
                { "op": "copy", "from": "PID.3", "to": "col.patient_id" },
                { "op": "copy", "from": "OBX.3.1", "to": "col.test_code" },
                { "op": "copy", "from": "OBX.5", "to": "col.value" },
                { "op": "datetime", "from": "OBX.14", "to": "col.result_time", "input": "yyyyMMddHHmmss", "output": "yyyy-MM-dd HH:mm:ss" }
              ] } }
          ] },
        { "channel_id": "hl7-enh", "label": "HL7 enhanced ACK", "kind": "message",
          "source": { "endpoint": "hl7-in-enh", "protocol": "hl7_mllp", "settings": { "ack_mode": "enhanced", "send_application_ack": true } },
          "destinations": [
            { "destination_id": "csv", "label": "CSV file", "endpoint": "out-dir", "protocol": "delimited_file",
              "settings": {
                "header_row": true, "file_name": "enh-{message_id}.csv", "line_ending": "crlf",
                "columns": [
                  { "name": "sample_id", "position": 1 }, { "name": "patient_id", "position": 2 },
                  { "name": "test_code", "position": 3 }, { "name": "value", "type": "decimal", "position": 4 },
                  { "name": "result_time", "type": "datetime", "format": "yyyy-MM-dd HH:mm:ss", "position": 5 }
                ] },
              "mapping": { "rules": [
                { "op": "copy", "from": "OBR.3", "to": "col.sample_id" },
                { "op": "copy", "from": "PID.3", "to": "col.patient_id" },
                { "op": "copy", "from": "OBX.3.1", "to": "col.test_code" },
                { "op": "copy", "from": "OBX.5", "to": "col.value" },
                { "op": "datetime", "from": "OBX.14", "to": "col.result_time", "input": "yyyyMMddHHmmss", "output": "yyyy-MM-dd HH:mm:ss" }
              ] } }
          ] }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "inst2": { "kind": "tcp_client" },
    "files": { "kind": "folder", "resource": "out" }
  },
  "no_body_leak": ["PID-TEST-002", "PID-TEST-003", "TEST^PATIENT"],
  "steps": [
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.orig}" },
    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-IN-1|P|2.5.1",
        "PID|1||PID-TEST-002||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0002|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||95|mg/dL|70-110|N|||F|||20260101115900"
      ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-IN-1" }, "count": 1,
      "each": { "state": "routed", "response_code": "AA", "sample_id": "SID-0002", "patient_id": "PID-TEST-002",
                "message_type": "ORU^R01", "committed_at": { "exists": true }, "responded_at": { "exists": true } } },
    { "do": "expect_file", "actor": "files", "pattern": "orig-*.csv",
      "equals": { "text": "sample_id,patient_id,test_code,value,result_time\r\nSID-0002,PID-TEST-002,GLU,95,2026-01-01 11:59:00\r\n" } },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "message.control_id": "CTRL-IN-1" }, "count": 1,
      "each": { "state": "acknowledged", "ack_level": "handed_off" } },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AR",
      "segments": [ "ZZZ|this is not an HL7 message" ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "channel_id": "hl7-orig", "state": "invalid" }, "count": 1,
      "each": { "response_code": "AR", "original_text": { "contains": "this is not an HL7 message" }, "reason_code": { "exists": true } } },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "message.state": "invalid" }, "count": 0, "within_ms": 0 },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "hl7-orig" },
      "expect": { "counters.received": 2, "counters.invalid": 1, "state": "running" } },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA",
      "note": "accepted and stored, then excluded by the source filter: not an ORU",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120300||ADT^A01|CTRL-IN-ADT|P|2.5.1",
        "PID|1||PID-TEST-002||TEST^PATIENT||19700101|F"
      ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-IN-ADT" }, "count": 1,
      "each": { "state": "filtered", "response_code": "AA", "reason_code": "source_filter" } },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "message.control_id": "CTRL-IN-ADT" }, "count": 0, "within_ms": 0 },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "hl7-orig" },
      "expect": { "counters.received": 3, "counters.filtered": 1 } },

    { "do": "connect", "actor": "inst2", "host": "127.0.0.1", "port": "${port.enh}" },
    { "do": "send_message", "actor": "inst2", "protocol": "hl7_mllp", "expect_reply": ["CA", "AA"],
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120100||ORU^R01|CTRL-IN-2|P|2.5.1|||AL|AL",
        "PID|1||PID-TEST-003||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0003|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||101|mg/dL|70-110|H|||F|||20260101120000"
      ] },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "control_id": "CTRL-IN-2" }, "count": 1,
      "each": { "state": "routed", "response_code": "CA", "sample_id": "SID-0003" } },
    { "do": "expect_file", "actor": "files", "pattern": "enh-*.csv", "contains": ["SID-0003", "PID-TEST-003", "GLU,101,2026-01-01 12:00:00"] },

    { "do": "assert_log", "actor": "engine", "event": "message.invalid", "fields": { "channel_id": "hl7-orig" }, "count": 1 }
  ]
}
