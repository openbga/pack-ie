    "mapping_version": 1,
    "total_attempts": 1
   }
  },
  {
   "do": "assert_store",
   "actor": "engine",
   "table": "deliveries",
   "where": {
    "destination_id": "lis2"
   },
   "count": 1,
   "each": {
    "state": "failed",
    "reason_code": "transform_error",
