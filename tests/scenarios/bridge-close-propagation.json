{
  "format": 1,
  "name": "bridge-close-propagation",
  "description": "When one side closes, the bridge closes the other side, retries, and recovers with a new session.",
  "requirements": ["BRG-02", "EPT-06", "LOG-01"],
  "timeout_ms": 30000,
  "resources": { "ports": ["a"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "inst-side", "label": "Instrument side", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.a}" } },
        { "endpoint_id": "sys-side", "label": "System side", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.sys.port}" } }
      ],
      "channels": [
        { "channel_id": "bridge-1", "label": "Bridge 1", "kind": "bridge",
          "endpoint_a": "inst-side", "endpoint_b": "sys-side",
          "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
          "retry": { "initial_delay_ms": 200, "max_delay_ms": 1000, "multiplier": 2.0, "jitter_percent": 0, "max_consecutive_failures_before_alert": 3 } }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "sys": { "kind": "tcp_server" }
  },
  "steps": [
    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },

    { "do": "send", "actor": "sys", "text": "bye\n" },
    { "do": "expect", "actor": "inst", "text": "bye\n" },
    { "do": "close", "actor": "sys" },

    { "do": "expect_closed", "actor": "inst" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": {
        "state": "retrying",
        "endpoint_a.state": "listening",
        "retry_count": { "gte": 1 },
        "last_error_summary": { "contains": "read failed: peer closed the connection" }
      } },
    { "do": "assert_log", "actor": "engine", "event": "bridge.close_propagated", "fields": { "channel_id": "bridge-1" } },
    { "do": "assert_log", "actor": "engine", "event": "endpoint.retry_scheduled", "fields": { "channel_id": "bridge-1" } },

    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },
    { "do": "send", "actor": "inst", "text": "again\n" },
    { "do": "expect", "actor": "sys", "text": "again\n" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "retry_count": 0, "endpoint_b.consecutive_failure_count": 0 } }
  ]
}
