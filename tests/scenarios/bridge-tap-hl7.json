{
  "format": 1,
  "name": "bridge-tap-hl7",
  "description": "An HL7 tap on a bridge counts and records the messages in each direction without altering or delaying the stream, and never treats a retransmission as a duplicate.",
  "requirements": ["BRG-04", "BRG-01", "PRO-05", "LOG-02"],
  "timeout_ms": 30000,
  "resources": { "ports": ["a"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "inst-side", "label": "Instrument side", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.a}" } },
        { "endpoint_id": "sys-side", "label": "System side", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.sys.port}" } }
      ],
      "channels": [
        { "channel_id": "bridge-tap", "label": "Bridge with HL7 tap", "kind": "bridge",
          "endpoint_a": "inst-side", "endpoint_b": "sys-side",
          "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
          "tap": { "framer": "hl7_mllp", "record_messages": true },
          "retry": { "initial_delay_ms": 200, "max_delay_ms": 1000, "multiplier": 2.0, "jitter_percent": 0, "max_consecutive_failures_before_alert": 3 } }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "sys": { "kind": "tcp_server" }
  },
  "no_body_leak": ["PID-TEST-011", "TEST^PATIENT"],
  "steps": [
    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-tap" },
      "expect": { "state": "running", "tap.framer": "hl7_mllp", "counters.messages_a_to_b": 0, "counters.messages_b_to_a": 0 } },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA", "async": true, "name": "m1",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-TAP-1|P|2.5.1",
        "PID|1||PID-TEST-011||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0014|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||95|mg/dL|70-110|N|||F|||20260101115900"
      ] },
    { "do": "expect_message", "actor": "sys", "protocol": "hl7_mllp", "reply": "AA",
      "assert": [ { "path": "MSH.10", "equals": "CTRL-TAP-1" }, { "path": "OBX.5", "equals": "95" } ] },
    { "do": "await_send", "actor": "inst", "name": "m1" },

    { "do": "send_message", "actor": "inst", "protocol": "hl7_mllp", "expect_reply": "AA", "async": true, "name": "m2",
      "note": "byte-identical repeat: still observed, never a duplicate",
      "segments": [
        "MSH|^~\\&|SIMLAB|SIMFAC|PACKIE|PACKIEFAC|20260101120000||ORU^R01|CTRL-TAP-1|P|2.5.1",
        "PID|1||PID-TEST-011||TEST^PATIENT||19700101|F",
        "OBR|1||SID-0014|GLU^Glucose",
        "OBX|1|NM|GLU^Glucose||95|mg/dL|70-110|N|||F|||20260101115900"
      ] },
    { "do": "expect_message", "actor": "sys", "protocol": "hl7_mllp", "reply": "AA",
      "assert": [ { "path": "MSH.10", "equals": "CTRL-TAP-1" } ] },
    { "do": "await_send", "actor": "inst", "name": "m2" },

    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-tap" },
      "expect": { "state": "running", "counters.messages_a_to_b": 2, "counters.messages_b_to_a": 2,
                  "counters.framing_errors": 0, "counters.tap_dropped": 0 } },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "channel_id": "bridge-tap", "direction": "a_to_b" }, "count": 2,
      "each": { "state": "observed", "origin": "tap", "protocol": "hl7_mllp", "control_id": "CTRL-TAP-1", "original_text": { "contains": "OBX|1|NM" } } },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "channel_id": "bridge-tap", "direction": "b_to_a" }, "count": 2,
      "each": { "state": "observed", "origin": "tap" } },
    { "do": "assert_store", "actor": "engine", "table": "messages", "where": { "channel_id": "bridge-tap", "state": "duplicate" }, "count": 0, "within_ms": 0 },
    { "do": "assert_store", "actor": "engine", "table": "deliveries", "where": { "channel_id": "bridge-tap" }, "count": 0, "within_ms": 0 }
  ]
}
