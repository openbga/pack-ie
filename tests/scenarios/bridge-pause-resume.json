{
  "format": 1,
  "name": "bridge-pause-resume",
  "description": "An operator pause stops a bridge intentionally with no retry and a released listener; resume restarts it from the active definition.",
  "requirements": ["BRG-05", "CON-03", "ENG-02"],
  "timeout_ms": 30000,
  "resources": { "ports": ["a"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "inst-side", "label": "Instrument side", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.a}" } },
        { "endpoint_id": "sys-side", "label": "System side", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.sys.port}" } }
      ],
      "channels": [
        { "channel_id": "bridge-1", "label": "Bridge 1", "kind": "bridge",
          "endpoint_a": "inst-side", "endpoint_b": "sys-side",
          "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
          "retry": { "initial_delay_ms": 200, "max_delay_ms": 1000, "multiplier": 2.0, "jitter_percent": 0, "max_consecutive_failures_before_alert": 3 } }
      ]
    }
  },
  "actors": {
    "inst": { "kind": "tcp_client" },
    "sys": { "kind": "tcp_server" }
  },
  "steps": [
    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },
    { "do": "send", "actor": "inst", "text": "before\n" },
    { "do": "expect", "actor": "sys", "text": "before\n" },

    { "do": "resume_channel", "actor": "engine", "channel": "bridge-1", "expect": "rejected", "reason_code": "not_paused" },
    { "do": "pause_channel", "actor": "engine", "channel": "bridge-1" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "stopped", "stop_reason": "operator_paused", "next_retry_at": null,
                  "endpoint_a.state": "disconnected", "endpoint_b.state": "disconnected" } },
    { "do": "assert_snapshot", "actor": "engine", "target": { "node": true }, "expect": { "node_state": "healthy" } },
    { "do": "expect_closed", "actor": "inst" },
    { "do": "expect_closed", "actor": "sys" },
    { "do": "pause_channel", "actor": "engine", "channel": "bridge-1", "expect": "rejected", "reason_code": "already_stopped" },
    { "do": "restart_channel", "actor": "engine", "channel": "bridge-1", "expect": "rejected", "reason_code": "operator_paused" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}", "expect": "refused" },
    { "do": "accept", "actor": "sys", "expect": "none", "timeout_ms": 800 },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "within_ms": 0, "expect": { "state": "stopped", "retry_count": 0 } },

    { "do": "resume_channel", "actor": "engine", "channel": "bridge-1" },
    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "inst", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged", "stop_reason": null } },
    { "do": "send", "actor": "sys", "text": "after\n" },
    { "do": "expect", "actor": "inst", "text": "after\n" },
    { "do": "assert_log", "actor": "engine", "event": "operator.command", "fields": { "command": "pause_channel", "result": "accepted" } }
  ]
}
