{
  "format": 1,
  "name": "bridge-listener-single-session",
  "description": "A second peer is reset while a session is active, the first session is untouched, and the listener stays bound so a reconnecting instrument is accepted during backoff.",
  "requirements": ["BRG-02", "EPT-02", "LOG-03"],
  "timeout_ms": 40000,
  "resources": { "ports": ["a"] },
  "engine": {
    "runtime": {
      "schema_version": 1,
      "endpoints": [
        { "endpoint_id": "inst-side", "label": "Instrument side", "kind": "tcp_listener",
          "settings": { "bind_address": "127.0.0.1", "port": "${port.a}", "accept_backlog": 1 } },
        { "endpoint_id": "sys-side", "label": "System side", "kind": "tcp_client",
          "settings": { "host": "127.0.0.1", "port": "${actor.sys.port}" } }
      ],
      "channels": [
        { "channel_id": "bridge-1", "label": "Bridge 1", "kind": "bridge",
          "endpoint_a": "inst-side", "endpoint_b": "sys-side",
          "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
          "retry": { "initial_delay_ms": 400, "max_delay_ms": 1000, "multiplier": 2.0, "jitter_percent": 0, "max_consecutive_failures_before_alert": 3 } }
      ]
    }
  },
  "actors": {
    "first": { "kind": "tcp_client" },
    "second": { "kind": "tcp_client" },
    "sys": { "kind": "tcp_server" }
  },
  "steps": [
    { "do": "accept", "actor": "sys" },
    { "do": "connect", "actor": "first", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },

    { "do": "connect", "actor": "second", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "expect_closed", "actor": "second" },
    { "do": "assert_log", "actor": "engine", "event": "listener.peer_rejected",
      "fields": { "channel_id": "bridge-1", "error_code": "session_active" } },
    { "do": "expect_open", "actor": "first", "for_ms": 300 },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged", "retry_count": 0 } },
    { "do": "send", "actor": "first", "text": "first-client\n" },
    { "do": "expect", "actor": "sys", "text": "first-client\n" },
    { "do": "send", "actor": "sys", "text": "ack-first\n" },
    { "do": "expect", "actor": "first", "text": "ack-first\n" },

    { "do": "close", "actor": "first" },
    { "do": "expect_closed", "actor": "sys" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "retrying", "endpoint_a.state": "listening" } },

    { "do": "connect", "actor": "second", "host": "127.0.0.1", "port": "${port.a}" },
    { "do": "accept", "actor": "sys" },
    { "do": "assert_snapshot", "actor": "engine", "target": { "channel": "bridge-1" },
      "expect": { "state": "running", "session_state": "bridged" } },
    { "do": "send", "actor": "second", "text": "second-client\n" },
    { "do": "expect", "actor": "sys", "text": "second-client\n" }
  ]
}
