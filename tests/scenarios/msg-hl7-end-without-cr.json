{
 "format": 1,
 "name": "msg-hl7-end-without-cr",
 "description": "With require_end_cr false, MLLP frames that end at 0x1C without CR are acknowledged one by one (also back to back and with a CR present), and a destination acknowledgement without the CR is accepted.",
 "requirements": [
  "PRO-03",
  "MSG-02",
  "MSG-03"
 ],
 "timeout_ms": 30000,
 "resources": {
  "ports": [
   "in"
  ]
 },
 "engine": {
  "runtime": {
   "schema_version": 1,
   "endpoints": [
    {
     "endpoint_id": "src",
     "label": "Source",
     "kind": "tcp_listener",
     "settings": {
      "bind_address": "127.0.0.1",
      "port": "${port.in}"
     }
    },
    {
     "endpoint_id": "dst",
     "label": "Destination",
     "kind": "tcp_client",
     "settings": {
      "host": "127.0.0.1",
      "port": "${actor.lis.port}"
     }
    }
   ],
   "channels": [
    {
     "channel_id": "hl7-ecr",
     "label": "HL7 sender without end CR",
     "kind": "message",
     "retry": {
      "initial_delay_ms": 200,
      "max_delay_ms": 1000,
      "multiplier": 2.0,
      "jitter_percent": 0,
      "max_consecutive_failures_before_alert": 3
     },
     "source": {
      "endpoint": "src",
      "protocol": "hl7_mllp",
      "settings": {
       "ack_mode": "original",
       "require_end_cr": false
      }
     },
     "destinations": [
      {
       "destination_id": "lis",
       "label": "LIS",
       "endpoint": "dst",
       "protocol": "hl7_mllp",
       "settings": {
        "ack_mode": "original",
        "require_end_cr": false
       },
       "mapping": null,
       "delivery": {
        "ack_timeout_seconds": 5
       }
      }
     ]
    }
   ]
  }
 },
 "actors": {
  "inst": {
   "kind": "tcp_client"
  },
  "lis": {
   "kind": "tcp_server"
  }
 },
 "no_body_leak": [
  "PID-TEST-501",
  "TEST^PATIENT"
 ],
