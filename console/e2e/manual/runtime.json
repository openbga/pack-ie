{
  "schema_version": 1,
  "endpoints": [
    {
      "endpoint_id": "inst-side",
      "label": "Instrument side (listener)",
      "kind": "tcp_listener",
      "settings": { "bind_address": "127.0.0.1", "port": 5301 }
    },
    {
      "endpoint_id": "sys-side",
      "label": "System side (client)",
      "kind": "tcp_client",
      "settings": { "host": "127.0.0.1", "port": 5302 }
    },
    {
      "endpoint_id": "hl7-in",
      "label": "HL7 results in",
      "kind": "tcp_listener",
      "settings": { "bind_address": "127.0.0.1", "port": 5401 }
    },
    {
      "endpoint_id": "lis-out",
      "label": "LIS HL7 out",
      "kind": "tcp_client",
      "settings": { "host": "127.0.0.1", "port": 5402 }
    }
  ],
  "channels": [
    {
      "channel_id": "bridge-1",
      "label": "Instrument to system",
      "kind": "bridge",
      "endpoint_a": "inst-side",
      "endpoint_b": "sys-side",
      "connection": { "connect_strategy": "parallel", "pairing_timeout_ms": 3000 },
      "retry": {
        "initial_delay_ms": 500,
        "max_delay_ms": 3000,
        "multiplier": 2.0,
        "jitter_percent": 0,
        "max_consecutive_failures_before_alert": 3
      }
    },
    {
      "channel_id": "hl7-results",
      "label": "HL7 results to LIS",
      "kind": "message",
      "source": {
        "endpoint": "hl7-in",
        "protocol": "hl7_mllp",
        "settings": { "ack_mode": "original" }
      },
      "destinations": [
        {
          "destination_id": "lis",
          "label": "LIS",
          "endpoint": "lis-out",
          "protocol": "hl7_mllp",
          "settings": { "ack_mode": "original" },
          "delivery": {
            "max_attempts": 3,
            "retry": {
              "initial_delay_ms": 1000,
              "max_delay_ms": 3000,
              "multiplier": 2.0,
              "jitter_percent": 0
            }
          }
        }
      ]
    }
  ]
}
