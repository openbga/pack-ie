# One frame is sent once plus six retransmissions; the seventh NAK abandons the message.
option max_frame_retransmissions 6
record H|\^&|||PACKIE^1.0
submit
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer NAK
expect write EOT
expect stop_timer
expect send_aborted retry_limit
