# The driver is reusable: after MessageSent the next submit starts a fresh establishment with frame number 1.
record H|\^&|||PACKIE^1.0
submit
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
record L|1|N
submit
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final L|1|N<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
