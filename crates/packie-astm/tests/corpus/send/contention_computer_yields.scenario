# Both sides send ENQ at once. The computer yields, then receives the instrument's message
# and only afterwards sends its own.
record H|\^&|||PACKIE^1.0
record L|1|N
submit
expect write ENQ
expect timer 15
peer ENQ
expect timer 20
tick stale
# The instrument sends ENQ again within 20 s: the computer receives.
peer ENQ
expect stop_timer
expect write ACK
expect timer 30
peer frame 1 final H|\^&|||SYN-ANALYZER<CR>
expect persist
expect timer 30
persist
expect write ACK
expect timer 30
peer frame 2 final L|1|N<CR>
expect persist
expect timer 30
persist
expect write ACK
expect timer 30
peer EOT
expect stop_timer
expect received H|\^&|||SYN-ANALYZER ; L|1|N
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer ACK
expect frame 2 final L|1|N<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
