# NAK to ENQ means the receiver is busy: wait 10 s, then send ENQ again.
record H|\^&|||PACKIE^1.0
submit
expect write ENQ
expect timer 15
peer NAK
expect timer 10
tick
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
