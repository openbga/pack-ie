# Computer role sends an order download: ENQ, ACK, one frame per record, EOT.
record H|\^&|||PACKIE^1.0|||||||P|LIS2-A2|20261012120000
record P|1|SYN-PRACTICE|SYN-LAB
record O|1|SYN-0001||^^^SYN-A|R||||||N
record L|1|N
submit
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0|||||||P|LIS2-A2|20261012120000<CR>
expect timer 15
peer ACK
expect frame 2 final P|1|SYN-PRACTICE|SYN-LAB<CR>
expect timer 15
peer ACK
expect frame 3 final O|1|SYN-0001||^^^SYN-A|R||||||N<CR>
expect timer 15
peer ACK
expect frame 4 final L|1|N<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
