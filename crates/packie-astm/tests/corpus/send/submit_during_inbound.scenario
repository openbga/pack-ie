# A message submitted while an inbound transfer runs waits for the line, then goes out after the inbound EOT.
peer ENQ
expect write ACK
expect timer 30
record H|\^&|||PACKIE^1.0
submit
peer frame 1 final H|\^&|||SYN-ANALYZER<CR>
expect persist
expect timer 30
persist
expect write ACK
expect timer 30
peer frame 2 final L|1|N<CR>
expect persist
expect timer 30
persist
expect write ACK
expect timer 30
peer EOT
expect stop_timer
expect received H|\^&|||SYN-ANALYZER ; L|1|N
expect write ENQ
expect timer 15
peer ACK
expect frame 1 final H|\^&|||PACKIE^1.0<CR>
expect timer 15
peer ACK
expect stop_timer
expect write EOT
expect sent
